{
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,assets/**,admin/**,server/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "x-fi-config", "value": "v2" }]
    }
  ]
}
