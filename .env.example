# העתיקו לקובץ .env והתאימו לסביבה שלכם
NODE_ENV=production
PORT=8080

# האם האתר רץ מאחורי פרוקסי (nginx / cloudflare / render / railway)
# כשמופעל, השרת סומך על X-Forwarded-* ומסמן את עוגיית ההתחברות כ-Secure
TRUST_PROXY=1

# כפיית עוגיות Secure גם ללא פרוקסי (רק כשיש HTTPS)
FORCE_SECURE_COOKIE=1

# מקור מורשה לפאנל הניהול — משמש לבדיקת Origin מול CSRF
PUBLIC_ORIGIN=https://fruitisland.co.il

# ───────────── פריסה ל-Vercel ─────────────
# בענן אין דיסק לכתיבה, ולכן שלושת המשתנים הבאים הם חובה.
# הריצו "npm run admin:hash" כדי לייצר אותם.

# סוד לחתימת עוגיות ההתחברות. בלעדיו אי אפשר להתחבר לפאנל.
SESSION_SECRET=

# פרטי משתמש הניהול. הסיסמה נשמרת כ-hash בלבד, לעולם לא כטקסט גלוי.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_DISPLAY_NAME=

# אחסון התוכן והמדיה. מתקבל אוטומטית כשמחברים Blob Store בלוח הבקרה של Vercel.
BLOB_READ_WRITE_TOKEN=

